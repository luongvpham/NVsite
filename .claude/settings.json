{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-write.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/appsettings.Production*.json)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(docker system prune*)",
      "PowerShell(docker system prune*)",
      "Bash(docker volume rm*)",
      "PowerShell(docker volume rm*)"
    ],
    "allow": [
      "mcp__codegraph__codegraph_**",
      "mcp__okf-producer__**",
      "Edit",
      "Write",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet ef migrations list*)",
      "Bash(dotnet ef migrations add*)",
      "Bash(dotnet ef database update*)",
      "Bash(pnpm test*)",
      "Bash(pnpm --filter*)",
      "Bash(pnpm gen*)",
      "Bash(pnpm check*)",
      "Bash(pnpm contract*)",
      "Bash(pnpm build*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(node tools/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(az account show*)",
      "Bash(az extension add*)",
      "Bash(az extension list*)",
      "Bash(az devops login*)",
      "Bash(az repos list*)",
      "Bash(az devops invoke*)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "PowerShell(dotnet ef migrations list*)",
      "PowerShell(dotnet ef migrations add*)",
      "PowerShell(dotnet ef database update*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm --filter*)",
      "PowerShell(pnpm gen*)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm contract*)",
      "PowerShell(pnpm build*)",
      "PowerShell(pnpm install --frozen-lockfile*)",
      "PowerShell(node tools/*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git rev-list*)",
      "PowerShell(git merge-base*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git branch --show-current*)",
      "PowerShell(git checkout*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git stash*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm tsc --noEmit*)",
      "Bash(pnpm vitest run*)",
      "Bash(docker info*)",
      "Bash(docker version*)",
      "Bash(dotnet list *)",
      "Bash(git check-ignore *)",
      "Bash(where *)",
      "PowerShell(pnpm lint*)",
      "PowerShell(pnpm tsc --noEmit*)",
      "PowerShell(pnpm vitest run*)",
      "PowerShell(docker info*)",
      "PowerShell(docker version*)",
      "PowerShell(dotnet list *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(findstr *)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(ConvertFrom-Json*)",
      "PowerShell(Get-Process*)",
      "PowerShell(Get-NetTCPConnection*)"
    ]
  }
}

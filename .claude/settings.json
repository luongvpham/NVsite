{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-write.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_**",
      "mcp__okf-producer__**",
      "Edit",
      "Write",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet ef migrations list*)",
      "Bash(dotnet ef migrations add*)",
      "Bash(dotnet ef database update*)",
      "Bash(pnpm test*)",
      "Bash(pnpm --filter*)",
      "Bash(pnpm gen*)",
      "Bash(pnpm check*)",
      "Bash(pnpm contract*)",
      "Bash(pnpm build*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(node tools/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(az account show*)",
      "Bash(az extension add*)",
      "Bash(az extension list*)",
      "Bash(az devops login*)",
      "Bash(az repos list*)",
      "Bash(az devops invoke*)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "PowerShell(dotnet ef migrations list*)",
      "PowerShell(dotnet ef migrations add*)",
      "PowerShell(dotnet ef database update*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm --filter*)",
      "PowerShell(pnpm gen*)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm contract*)",
      "PowerShell(pnpm build*)",
      "PowerShell(pnpm install --frozen-lockfile*)",
      "PowerShell(node tools/*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git rev-list*)",
      "PowerShell(git merge-base*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git branch --show-current*)",
      "PowerShell(git checkout*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git stash*)"
    ]
  }
}

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Api / hosting -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Sanitize richText phía BE (T4, WEBSITE-001, #67, G4). MIT; kéo AngleSharp 1.7.2 + AngleSharp.Css 1.0.2 (MIT). -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.9" />
    <!-- Application layer -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- snake_case cho toàn bộ tên bảng/cột/ràng buộc (REFACTOR-DB-001) -->
    <PackageVersion Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.9" />
    <!-- Identity / Auth (Quyết định #3 — không OIDC/OpenIddict, tự cấp JWT) -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="9.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <!-- Imaging pipeline (#53, #84, #85). SkiaSharp (MIT) thay ImageSharp: mọi bản ImageSharp đã vá CVE (>= 4.1.2)
         đòi file license lúc build — xem Docs/tasks/SEC-IMAGESHARP-001/changelog.md. -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.9" />
    <!-- Object storage (T2, MEDIA-001, Quyết định #75/#83) -->
    <PackageVersion Include="AWSSDK.S3" Version="3.7.501.18" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.9" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="3.10.0" />
    <!-- S3ObjectStorage contract test (T2, MEDIA-001) — cùng bản với Testcontainers.PostgreSql/Redis.
         Đổi từ Testcontainers.Minio: minio/minio không còn publish image public (Docker Hub và
         quay.io đều từ chối pull, xác nhận 2026-09-27) — xem backend/docs/modules/media.md §6. -->
    <PackageVersion Include="Testcontainers.LocalStack" Version="3.10.0" />
    <!-- Pin phụ thuộc bắc cầu của Testcontainers 3.10.0 (SSH.NET 2023.0.0 dính GHSA-q939-rpr3-3284). Chỉ test dùng; bỏ pin khi Testcontainers tự kéo bản >= 2026.0.0. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
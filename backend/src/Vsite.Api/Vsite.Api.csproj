<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Xuất OpenAPI document tĩnh lúc build — nguồn cho tools/contract-sync (backend/CLAUDE.md). -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/obj/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vsite.Application\Vsite.Application.csproj" />
    <!-- Infrastructure CHỈ để gọi AddInfrastructure() trong Program.cs (DI wiring) —
         endpoint/handler không được dùng type của Infrastructure (architecture-guide.md §1). -->
    <ProjectReference Include="..\Vsite.Infrastructure\Vsite.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Shared framework bundle một bản EFCore.Relational khác version với Npgsql (qua
         Vsite.Infrastructure) — pin tường minh để tránh MSB3277 (conflict version). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- `dotnet ef` dùng project này làm startup project để lấy connection string từ appsettings
         (MỘT nguồn duy nhất, không có IDesignTimeDbContextFactory hardcode thứ hai). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- config/reserved-routes.json là nguồn sự thật duy nhất (Quyết định #24) — link vào, không copy tay. -->
    <None Include="..\..\..\config\reserved-routes.json" Link="config\reserved-routes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

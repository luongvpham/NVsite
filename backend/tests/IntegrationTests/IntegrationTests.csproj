<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Testcontainers.PostgreSql kéo theo Npgsql/EF Core Relational bản khác — pin tường minh để
         tránh MSB3277 (conflict version) khi build. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vsite.Api kéo theo Application/Infrastructure/Domain; cần chính nó để
         WebApplicationFactory<Program> tìm được entry point. -->
    <ProjectReference Include="..\..\src\Vsite.Api\Vsite.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test đọc lại byte output (Image.Identify) để verify metadata bị xoá / dimension đúng —
         không cần Docker, chạy trực tiếp trên IImageProcessor (T1, MEDIA-001). -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ObjectStorageContractTests (T2, MEDIA-001): LocalDisk không cần Docker; S3ObjectStorageTests
         cần MinIO container — xem Docs/DOCKER-TEST-DEBT.md. -->
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Testcontainers.Minio" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

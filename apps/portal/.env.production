# Production: Caddy reverse-proxy mọi domain (kể cả admin.vsite.vn) về cùng backend, giữ nguyên
# Host header (Quyết định #9) — vẫn same-origin từ góc nhìn trình duyệt, nên giá trị giống dev/test.
# Xem .env.development để biết đầy đủ lý do.
VITE_API_BASE_URL=/

# Link "Mở site" bị ẩn cho tới khi deploy production.
VITE_SHOP_SITE_ORIGIN_TEMPLATE=
